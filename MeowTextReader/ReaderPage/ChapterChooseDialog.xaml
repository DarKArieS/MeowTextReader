<UserControl
    x:Class="MeowTextReader.ReaderPage.ChapterChooseDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MeowTextReader.ReaderPage"
    xmlns:main="using:MeowTextReader.MainPage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <main:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <local:BooleanToFontWeightConverter x:Key="BooleanToFontWeightConverter" />
        <local:BooleanToAccentBrushConverter
            x:Key="BooleanToAccentBrushConverter"
            AccentBrush="{ThemeResource AccentTextFillColorPrimaryBrush}"
            DefaultBrush="{ThemeResource TextFillColorPrimaryBrush}" />
    </UserControl.Resources>

    <Grid x:Name="RootGrid" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="SemiBold"
                Text="章節" />
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    x:Name="ChapterSettingButton"
                    AutomationProperties.Name="章節抓取設定"
                    Click="ChapterSettingButton_Click"
                    ToolTipService.ToolTip="章節抓取設定">
                    <FontIcon FontSize="14" Glyph="&#xE713;" />
                </Button>
                <Button
                    x:Name="RefreshChaptersButton"
                    AutomationProperties.Name="重新抓取章節"
                    Click="RefreshChapters_Click"
                    ToolTipService.ToolTip="重新抓取章節">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                </Button>
            </StackPanel>
        </Grid>
        <ListView
            x:Name="ChapterListView"
            Grid.Row="1"
            MaxHeight="480"
            IsItemClickEnabled="True"
            ItemClick="ChapterListView_ItemClick"
            ItemsSource="{Binding Chapters}"
            SelectionMode="None"
            Visibility="{Binding HasChapters, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="8,6" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!--  寬度貼合內容，只有超過上限的長標題才會換行；正在讀的章節用強調色+粗體標示  -->
                        <TextBlock
                            Grid.Column="0"
                            FontWeight="{Binding IsCurrent, Converter={StaticResource BooleanToFontWeightConverter}}"
                            Foreground="{Binding IsCurrent, Converter={StaticResource BooleanToAccentBrushConverter}}"
                            Text="{Binding Title}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            FontSize="12"
                            FontWeight="{Binding IsCurrent, Converter={StaticResource BooleanToFontWeightConverter}}"
                            Foreground="{Binding IsCurrent, Converter={StaticResource BooleanToAccentBrushConverter}}"
                            Text="{Binding LineNumber}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock
            Grid.Row="1"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="沒有抓到章節。可按右上角的齒輪調整章節抓取設定後再重新整理。"
            TextWrapping="Wrap"
            Visibility="{Binding HasChapters, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
    </Grid>
</UserControl>
