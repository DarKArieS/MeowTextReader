<Flyout
    x:Class="MeowTextReader.MainPage.ConfigSetting.ConfigSettingFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Opening="Flyout_Opening"
    mc:Ignorable="d">

    <StackPanel Width="440" Spacing="12">
        <TextBlock
            FontSize="16"
            FontWeight="SemiBold"
            Text="設定檔位置" />

        <TextBlock
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap">
            appConfig.json 存放的位置。變更後會把目前的設定搬到新位置。
        </TextBlock>

        <TextBox
            x:Name="PathTextBox"
            HorizontalAlignment="Stretch"
            IsReadOnly="True"
            TextWrapping="Wrap" />

        <TextBlock
            x:Name="DefaultHintText"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            Text="（預設位置）" />

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
                x:Name="ChangeLocationButton"
                Click="ChangeLocation_Click"
                Content="變更位置…" />
            <Button
                x:Name="OpenFileButton"
                Click="OpenFile_Click"
                Content="打開檔案" />
            <Button
                x:Name="OpenFolderButton"
                Click="OpenFolder_Click"
                Content="打開資料夾" />
        </StackPanel>
    </StackPanel>
</Flyout>
