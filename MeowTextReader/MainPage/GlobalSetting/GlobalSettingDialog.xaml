<ContentDialog
    x:Class="MeowTextReader.MainPage.GlobalSetting.GlobalSettingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chapterSetting="using:MeowTextReader.ChapterSetting"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="全域設定"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="SaveButton_Click"
    PrimaryButtonText="儲存"
    mc:Ignorable="d">

    <ScrollViewer Width="440" MaxHeight="560">
        <StackPanel Spacing="20">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="外觀" />
                <TextBlock
                    Margin="0,4,0,8"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap">
                    選擇應用程式的淺色／深色主題。
                </TextBlock>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <RadioButton
                        x:Name="ThemeDefaultRadio"
                        Checked="ThemeRadio_Checked"
                        Content="跟隨系統"
                        GroupName="Theme" />
                    <RadioButton
                        x:Name="ThemeLightRadio"
                        Checked="ThemeRadio_Checked"
                        Content="淺色"
                        GroupName="Theme" />
                    <RadioButton
                        x:Name="ThemeDarkRadio"
                        Checked="ThemeRadio_Checked"
                        Content="深色"
                        GroupName="Theme" />
                </StackPanel>
            </StackPanel>

            <chapterSetting:ChapterRegexSettingControl x:Name="ChapterRegexControl" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
